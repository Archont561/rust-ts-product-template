{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "UTC",
  "schedule": ["before 06:00 on Monday"],
  "labels": ["dependencies"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 06:00 on the first day of the month"]
  },
  "pixi": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Pin all GitHub Actions to full 40-char commit SHAs and group minor/patch updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Group Pixi toolchain & linter dependencies (pixi.toml / pixi.lock)",
      "matchManagers": ["pixi"],
      "groupName": "pixi-toolchain"
    },
    {
      "description": "Group TypeScript tooling, formatting, and Tasknest devDependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "js-dev-tooling"
    },
    {
      "description": "Group Tauri v2 JS/Rust packages together to prevent version skew",
      "matchPackageNames": ["/^@tauri-apps//", "/^tauri(-|$)/"],
      "groupName": "tauri-v2"
    },
    {
      "description": "Group non-major Cargo dependency updates across the Rust workspace",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "rust-workspace-non-major"
    },
    {
      "description": "Pin Docker base image digests in apps/web/Dockerfile and docker-compose.yml",
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true,
      "groupName": "docker-images"
    }
  ]
}
