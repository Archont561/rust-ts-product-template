{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product.local/schemas/change-filters.schema.json",
  "title": "CI Change Detection Filters",
  "description": "Enforces the `ci` profile of tools/ci/filters.json: every gateable CI job (ts, rust, web) must declare at least one non-empty workflow-style path pattern.",
  "type": "object",
  "minProperties": 1,
  "required": ["ci"],
  "properties": {
    "ci": {
      "$ref": "#/$defs/profile",
      "required": ["ts", "rust", "web"]
    }
  },
  "additionalProperties": { "$ref": "#/$defs/profile" },
  "$defs": {
    "profile": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        ]
      }
    }
  }
}
