{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product.local/schemas/renovate.schema.json",
  "title": "Renovate Multi-Ecosystem Configuration Policy",
  "description": "Enforces Renovate schema, SHA pinning for GitHub Actions, supply-chain minimumReleaseAge, Pixi manager support, and packageRules grouping.",
  "type": "object",
  "required": ["$schema", "extends", "minimumReleaseAge", "pixi", "packageRules"],
  "properties": {
    "$schema": {
      "const": "https://docs.renovatebot.com/renovate-schema.json"
    },
    "extends": {
      "type": "array",
      "contains": {
        "const": "helpers:pinGitHubActionDigests"
      },
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minimumReleaseAge": {
      "type": "string",
      "minLength": 1
    },
    "pixi": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "const": true
        }
      }
    },
    "packageRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
