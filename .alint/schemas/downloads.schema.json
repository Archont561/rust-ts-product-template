{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product.local/schemas/downloads.schema.json",
  "title": "Fumadocs Downloads Manifest Schema",
  "description": "Validates apps/docs/content/downloads.json so broken URLs, missing platforms, or malformed release versions cannot reach the Downloads showcase page.",
  "type": "object",
  "required": ["version", "desktop", "mobile", "extension"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "desktop": {
      "type": "array",
      "minItems": 3,
      "allOf": [
        {
          "contains": {
            "properties": { "target": { "pattern": "^macos-" } },
            "required": ["target"]
          }
        },
        {
          "contains": {
            "properties": { "target": { "pattern": "^linux-" } },
            "required": ["target"]
          }
        },
        {
          "contains": {
            "properties": { "target": { "pattern": "^windows-" } },
            "required": ["target"]
          }
        }
      ],
      "items": {
        "type": "object",
        "required": ["target", "label", "filename", "url", "sha256"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/httpsUrl" },
          "sha256": {
            "type": "string",
            "pattern": "^(pending-release|[0-9a-f]{64})$"
          }
        },
        "additionalProperties": false
      }
    },
    "mobile": {
      "type": "array",
      "minItems": 2,
      "allOf": [
        {
          "contains": {
            "properties": { "platform": { "const": "android" } },
            "required": ["platform"]
          }
        },
        {
          "contains": { "properties": { "platform": { "const": "ios" } }, "required": ["platform"] }
        }
      ],
      "items": {
        "type": "object",
        "required": ["platform", "label", "url"],
        "properties": {
          "platform": { "enum": ["android", "ios"] },
          "label": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/httpsUrl" }
        },
        "additionalProperties": false
      }
    },
    "extension": {
      "type": "array",
      "minItems": 3,
      "allOf": [
        {
          "contains": {
            "properties": { "browser": { "const": "chrome" } },
            "required": ["browser"]
          }
        },
        {
          "contains": {
            "properties": { "browser": { "const": "firefox" } },
            "required": ["browser"]
          }
        },
        {
          "contains": {
            "properties": { "browser": { "const": "safari" } },
            "required": ["browser"]
          }
        }
      ],
      "items": {
        "type": "object",
        "required": ["browser", "label", "url"],
        "properties": {
          "browser": { "enum": ["chrome", "firefox", "safari"] },
          "label": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/httpsUrl" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    }
  }
}
