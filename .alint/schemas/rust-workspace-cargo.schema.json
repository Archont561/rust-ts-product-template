{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product.local/schemas/rust-workspace-cargo.schema.json",
  "title": "Root Rust Workspace Cargo.toml Policy",
  "description": "Enforces Rust edition 2024, resolver 3, publish=false default, unsafe_code=forbid, zero-panic production Clippy lints, a vendorable Axum web app member, and isolation of native app crates in exclude.",
  "type": "object",
  "required": ["workspace"],
  "properties": {
    "workspace": {
      "type": "object",
      "required": ["resolver", "members", "exclude", "package", "lints"],
      "properties": {
        "resolver": {
          "const": "3"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(rust/(crates|adapters)/[a-z0-9_-]+|apps/web)$"
          }
        },
        "exclude": {
          "type": "array",
          "allOf": [
            { "contains": { "const": "apps/desktop/src-tauri" } },
            { "contains": { "const": "apps/mobile/src-tauri" } }
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "package": {
          "type": "object",
          "required": ["version", "edition", "license", "publish"],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
            },
            "edition": {
              "const": "2024"
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "publish": {
              "const": false
            }
          }
        },
        "lints": {
          "type": "object",
          "required": ["rust", "clippy"],
          "properties": {
            "rust": {
              "type": "object",
              "required": ["unsafe_code"],
              "properties": {
                "unsafe_code": {
                  "const": "forbid"
                }
              }
            },
            "clippy": {
              "type": "object",
              "required": [
                "all",
                "pedantic",
                "unwrap_used",
                "expect_used",
                "panic",
                "indexing_slicing",
                "todo",
                "unimplemented",
                "dbg_macro"
              ],
              "properties": {
                "unwrap_used": { "const": "deny" },
                "expect_used": { "const": "deny" },
                "panic": { "const": "deny" },
                "indexing_slicing": { "const": "deny" },
                "todo": { "const": "deny" },
                "unimplemented": { "const": "deny" },
                "dbg_macro": { "const": "deny" }
              }
            }
          }
        }
      }
    }
  }
}
