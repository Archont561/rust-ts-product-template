{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product.local/schemas/pixi-sandbox.schema.json",
  "title": "pixi-sandbox Offline Environment Configuration Policy",
  "description": "Enforces pixi-sandbox schema v1, cargo_vendor=true for offline Rust builds, publish budgets, and developer bundles covering default and rust/full environments.",
  "type": "object",
  "required": ["schema", "branch_prefix", "cargo_vendor", "budgets", "bundle"],
  "properties": {
    "schema": {
      "const": 1
    },
    "branch_prefix": {
      "type": "string",
      "minLength": 1
    },
    "cargo_vendor": {
      "const": true
    },
    "budgets": {
      "type": "object",
      "required": [
        "max_blob_mib",
        "max_transport_mib",
        "max_repository_push_mib",
        "max_restore_required_mib"
      ],
      "properties": {
        "max_blob_mib": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_transport_mib": { "type": "integer", "minimum": 64 },
        "max_repository_push_mib": { "type": "integer", "minimum": 64 },
        "max_restore_required_mib": { "type": "integer", "minimum": 128 }
      }
    },
    "bundle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "environments", "platforms"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "environments": {
            "type": "array",
            "minItems": 1,
            "allOf": [{ "contains": { "const": "default" } }, { "contains": { "const": "rust" } }],
            "items": {
              "enum": ["default", "js", "lint", "docs", "rust", "full"]
            }
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "contains": { "const": "linux-64" },
            "items": {
              "enum": ["linux-64", "osx-arm64", "win-64"]
            }
          }
        }
      }
    }
  }
}
