{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product.local/schemas/codecov-config.schema.json",
  "title": "Codecov Coverage Policy",
  "description": "Enforces per-language project status contexts (rust, typescript) with explicit flags, targets, and thresholds, plus carryforward flags whose paths match the monorepo layout.",
  "type": "object",
  "required": ["codecov", "coverage", "flags", "ignore"],
  "properties": {
    "codecov": {
      "type": "object",
      "required": ["require_ci_to_pass"],
      "properties": {
        "require_ci_to_pass": { "type": "boolean" }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "precision": { "type": "integer", "minimum": 0, "maximum": 5 },
        "round": { "enum": ["down", "up", "nearest"] },
        "range": { "type": "string", "pattern": "^[0-9]{1,3}\\.\\.\\.[0-9]{1,3}$" },
        "status": {
          "type": "object",
          "required": ["project", "patch"],
          "properties": {
            "project": {
              "type": "object",
              "required": ["rust", "typescript"],
              "properties": {
                "rust": {
                  "$ref": "#/$defs/coverageContext",
                  "properties": { "flags": { "const": ["rust"] } }
                },
                "typescript": {
                  "$ref": "#/$defs/coverageContext",
                  "properties": { "flags": { "const": ["ts"] } }
                }
              },
              "additionalProperties": { "$ref": "#/$defs/coverageContext" }
            },
            "patch": {
              "type": "object",
              "required": ["default"],
              "properties": {
                "default": {
                  "type": "object",
                  "required": ["target", "threshold"],
                  "properties": {
                    "target": { "$ref": "#/$defs/percentage" },
                    "threshold": { "$ref": "#/$defs/percentage" }
                  }
                }
              },
              "additionalProperties": {
                "type": "object",
                "required": ["target"],
                "properties": {
                  "target": { "$ref": "#/$defs/percentage" },
                  "threshold": { "$ref": "#/$defs/percentage" }
                }
              }
            }
          }
        }
      }
    },
    "flags": {
      "type": "object",
      "required": ["rust", "ts"],
      "additionalProperties": {
        "type": "object",
        "required": ["paths", "carryforward"],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "carryforward": { "type": "boolean" }
        }
      }
    },
    "ignore": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "percentage": {
      "anyOf": [
        { "const": "auto" },
        { "type": "string", "pattern": "^[0-9]{1,3}%$" },
        { "type": "number", "minimum": 0, "maximum": 100 }
      ]
    },
    "coverageContext": {
      "type": "object",
      "required": ["flags", "target", "threshold"],
      "properties": {
        "flags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "target": { "$ref": "#/$defs/percentage" },
        "threshold": { "$ref": "#/$defs/percentage" }
      }
    }
  }
}
