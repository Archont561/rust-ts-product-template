# Copy to `.env` for local `docker compose` runs (never commit real secrets).

# Offline local Postgres (`docker compose --profile local up`)
POSTGRES_USER=product
POSTGRES_PASSWORD=product
POSTGRES_DB=product
POSTGRES_PORT=5432
DATABASE_URL=postgres://product:product@db-local:5432/product

# Neon Local ephemeral branching (`docker compose --profile neon up`)
# NEON_API_KEY=napi_replace_me
# NEON_PROJECT_ID=replace_me
# NEON_PARENT_BRANCH_ID=br-replace-me
# NEON_DELETE_BRANCH=true

# Ports & Origin
WEB_PORT=8080
WORKER_PORT=8787
ORIGIN_URL=http://web:8080
