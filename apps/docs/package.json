{
  "name": "@product/app-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build"
  },
  "tasknest": {
    "tasks": {
      "dev": {
        "description": "Run the Fumadocs showcase and documentation site (apps/docs).",
        "marks": [
          "dev"
        ],
        "persistent": true
      },
      "build": {
        "description": "Build the static Fumadocs showcase and documentation site into apps/docs/out.",
        "marks": [
          "build",
          "docs"
        ],
        "requires": [
          "bun"
        ]
      }
    }
  },
  "dependencies": {
    "fumadocs-mdx": "^15.6.2",
    "fumadocs-ui": "^16.19.3",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
