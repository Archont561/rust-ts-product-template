{
  "name": "@product/app-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "tasknest": {
    "tasks": {
      "dev": {
        "description": "Run the Cloudflare Worker locally with Wrangler (apps/worker).",
        "marks": [
          "dev"
        ],
        "persistent": true
      }
    }
  },
  "dependencies": {
    "@product/application": "workspace:*",
    "@product/contracts": "workspace:*",
    "@product/infrastructure-http": "workspace:*",
    "@product/infrastructure-memory": "workspace:*",
    "@product/infrastructure-wasm": "workspace:*"
  }
}
