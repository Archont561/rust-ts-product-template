{
  "name": "@product/app-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build"
  },
  "tasknest": {
    "tasks": {
      "dev": {
        "description": "Launch the Tauri v2 desktop app in dev mode (apps/desktop).",
        "marks": [
          "dev"
        ],
        "persistent": true
      },
      "build": {
        "description": "Bundle Tauri v2 desktop installers for the host platform.",
        "marks": [
          "build",
          "release"
        ],
        "requires": [
          "bun"
        ]
      }
    }
  },
  "dependencies": {
    "@product/application": "workspace:*",
    "@product/contracts": "workspace:*",
    "@product/domain": "workspace:*",
    "@product/features": "workspace:*",
    "@product/infrastructure-http": "workspace:*",
    "@product/infrastructure-tauri": "workspace:*",
    "@product/ui": "workspace:*"
  },
  "devDependencies": {
    "@product/build-utils": "workspace:*"
  }
}
